rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'name', 'role', 'createdAt']) &&
             data.uid is string &&
             data.name is string &&
             data.name.size() <= 100 &&
             data.role in ['patient', 'doctor'] &&
             data.createdAt is timestamp;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && 
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone', 'specialty', 'photoURL']);
    }

    function isConsultationParticipant(data) {
      return isSignedIn() && (request.auth.uid == data.patientId || request.auth.uid == data.doctorId);
    }

    match /consultations/{consultationId} {
      allow read: if isSignedIn() && (request.auth.uid == resource.data.patientId || 
                                     (request.auth.uid == resource.data.doctorId || resource.data.status == 'pending'));
      allow create: if isSignedIn() && request.resource.data.patientId == request.auth.uid;
      allow update: if isSignedIn() && (
        (request.auth.uid == resource.data.patientId && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['description', 'audioUrl'])) ||
        (request.auth.uid == resource.data.doctorId) ||
        (resource.data.status == 'pending' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['doctorId', 'status']))
      );

      match /messages/{messageId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
      }
    }
  }
}
