rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'name', 'role', 'createdAt']) &&
             data.uid is string &&
             data.name is string &&
             data.name.size() <= 100 &&
             data.role in ['patient', 'doctor'] &&
             data.createdAt is timestamp;
    }

    function isValidMedicalHistory(data) {
      return data.medicalHistory is map &&
             data.medicalHistory.conditions is string &&
             data.medicalHistory.treatments is string &&
             data.medicalHistory.allergies is string;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone', 'specialty', 'photoURL'])) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['medicalHistory']) && isValidMedicalHistory(request.resource.data))
      );
    }

    function isConsultationParticipant(data) {
      return isSignedIn() && (request.auth.uid == data.patientId || request.auth.uid == data.doctorId);
    }

    function isDoctor() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'doctor';
    }

    match /consultations/{consultationId} {
      allow read: if isSignedIn() && (isOwner(resource.data.patientId) || isDoctor());
      allow create: if isSignedIn() && request.resource.data.patientId == request.auth.uid;
      allow update: if isSignedIn() && (
        isOwner(resource.data.patientId) || isDoctor()
      );

      match /messages/{messageId} {
        allow read: if isSignedIn() && (isOwner(get(/databases/$(database)/documents/consultations/$(consultationId)).data.patientId) || isDoctor());
        allow create: if isSignedIn();
      }
    }
  }
}
